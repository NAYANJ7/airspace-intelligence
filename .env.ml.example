# Append ONLY the settings you want to your existing .env. Do not replace it.
# Keep your existing POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD.
# Host CLI uses POSTGRES_HOST=localhost / POSTGRES_PORT=5432 unless already set.
# Compose explicitly uses postgres:5432 inside containers.

ML_MODEL_DIR=artifacts/ml
ML_TRAIN_LOOKBACK_DAYS=30
ML_TRAIN_MAX_ROWS=100000
ML_MIN_TRAIN_ROWS=1000
ML_SCORE_LOOKBACK_HOURS=72
ML_BATCH_SIZE=5000
ML_MAX_BATCHES=20
ML_N_ESTIMATORS=200
ML_MAX_SAMPLES=256
ML_CONTAMINATION=0.01
ML_RANDOM_STATE=42
ML_N_JOBS=1
ML_QUERY_TIMEOUT_S=120

# Optional ONLY when creating a new Airflow admin account. Existing accounts
# in airflow_home remain unchanged. Set a private value in .env, never here.
# AIRFLOW_ADMIN_PASSWORD=
